{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix api",
  "buildCommand": "mkdir -p public && printf 'Prescription API' > public/index.html",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 15
    }
  }
}
