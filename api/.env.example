# ---------------------------------------------------------------------------
# Prescription API environment variables.
#
# In production these are set in the Vercel dashboard
# (Project -> Settings -> Environment Variables), NOT committed here.
# This file documents the names only. For local `vercel dev`, copy it to
# `api/.env` (git-ignored) and fill in real values.
# ---------------------------------------------------------------------------

# Firebase service-account JSON, as a SINGLE-LINE string (the whole JSON object).
# Use a DEDICATED least-privilege service account, not the default owner key.
# Roles needed: "Firebase Authentication Viewer" + "Cloud Datastore User".
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","..."}

# Cloudinary credentials (Dashboard -> Product Environment Credentials).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of browser origins allowed to call this API (CORS).
# Include every origin the Flutter app is served from.
PRESCRIPTION_CORS_ORIGIN=https://health-hub-sdp4.web.app,https://health-hub-sdp4.firebaseapp.com,http://localhost:5000
