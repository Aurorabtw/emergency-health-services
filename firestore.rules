rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    function isAssignedAdmin(orgId, roles) {
      return isAuthenticated()
        && getUserData().organization_id == orgId
        && getUserData().role in roles;
    }

    function isBedAdmin(orgId) {
      return isAssignedAdmin(orgId, ['bed_admin', 'hospital_admin']);
    }

    function isTestAdmin(orgId) {
      return isAssignedAdmin(orgId, ['test_admin', 'hospital_admin']);
    }

    function isBloodBankAdmin(orgId) {
      return isAssignedAdmin(orgId, ['blood_bank_admin']);
    }

    function isAmbulanceAdmin(orgId) {
      return isAssignedAdmin(orgId, ['ambulance_admin']);
    }

    function canManageBooking(orgId, type) {
      return (type == 'bed' && isBedAdmin(orgId))
        || (type == 'blood' && isBloodBankAdmin(orgId))
        || (type == 'ambulance' && isAmbulanceAdmin(orgId));
    }

    function isProfileComplete() {
      return isAuthenticated() && getUserData().profile_complete == true;
    }

    // Organizations - public read, super admin write
    match /organizations/{orgId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();

      // Beds subcollection
      match /beds/{bedId} {
        allow read: if true;
        allow create, update, delete: if isBedAdmin(orgId) || isSuperAdmin();
      }

      // Ambulances subcollection
      match /ambulances/{vehicleId} {
        allow read: if true;
        allow create, update, delete: if isAmbulanceAdmin(orgId) || isSuperAdmin();
      }

      // Blood stock subcollection
      match /blood_stock/{stockId} {
        allow read: if true;
        allow create, update, delete: if isBloodBankAdmin(orgId) || isSuperAdmin();
      }

      // Tests subcollection
      match /tests/{testId} {
        allow read: if true;
        allow create, update, delete: if isTestAdmin(orgId) || isSuperAdmin();
      }
    }

    // Collection-group reads. The listing screens fetch all beds, ambulances,
    // blood stock and tests across every org in a single collectionGroup query.
    // Nested match rules do NOT apply to collectionGroup queries, so these
    // grant the same public read at group scope. Writes are unaffected and stay
    // restricted by the per-org nested rules above.
    match /{path=**}/beds/{bedId} { allow read: if true; }
    match /{path=**}/ambulances/{vehicleId} { allow read: if true; }
    match /{path=**}/blood_stock/{stockId} { allow read: if true; }
    match /{path=**}/tests/{testId} { allow read: if true; }

    // Booking requests
    match /booking_requests/{requestId} {
      allow create: if isAuthenticated() && isProfileComplete();

      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid
        || canManageBooking(resource.data.organization_id, resource.data.type)
        || isSuperAdmin()
      );

      allow update: if isAuthenticated() && (
        canManageBooking(resource.data.organization_id, resource.data.type)
        || isSuperAdmin()
        // Allow lazy expiry updates from any authenticated user reading the doc
        || (resource.data.user_id == request.auth.uid
            && request.resource.data.status == 'expired'
            && resource.data.status == 'confirmed')
      );

      allow delete: if isSuperAdmin()
        || (canManageBooking(resource.data.organization_id, resource.data.type)
          && resource.data.status in ['rejected', 'expired', 'admitted']);
    }

    // Platform config
    match /config/{docId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
      );

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.organization_id == null
        && (request.resource.data.role == 'patient'
          || (request.resource.data.role == 'super_admin'
            && !exists(/databases/$(database)/documents/config/platform)));

      allow update: if isSuperAdmin()
        || (isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.organization_id == resource.data.organization_id);

      allow delete: if isSuperAdmin();
    }
  }
}
